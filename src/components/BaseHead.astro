---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import config from '../content/config/config.json';

interface Props {
	title: string;
	description: string;
	image?: string | null;
}

const SITE_NAME = 'Casey Industrial Park';
const SITE_URL = (Astro.site && Astro.site.toString().replace(/\/$/, '')) || 'https://www.caseyindustrialpark.com';

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE_URL);

const props = Astro.props;
const rawTitle = props.title || config.seo.title;
const description = props.description || config.seo.description;
const hasHero = !!props.image;
const image = props.image || '/blog-placeholder-1.jpg';
const absImage = new URL(image, Astro.site || SITE_URL).toString();

// Full <title>: append site name unless this is already the site title
const fullTitle = rawTitle.trim() === config.seo.title.trim()
	? rawTitle
	: `${rawTitle} | ${SITE_NAME}`;

// --- Structured data (JSON-LD) -------------------------------------------
// NAP + geo. Locality "Campbell, OH" inferred from city-water reference and
// the property's own Google Maps coordinates; confirm exact street address.
const localBusiness = {
	'@context': 'https://schema.org',
	'@type': 'RealEstateAgent',
	name: SITE_NAME,
	url: SITE_URL,
	telephone: '+1-412-963-1111',
	faxNumber: '+1-412-963-0378',
	email: 'CCasey@CaseyUSA.com',
	image: absImage,
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Campbell',
		addressRegion: 'OH',
		addressCountry: 'US',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: 41.066722,
		longitude: -80.601631,
	},
	areaServed: 'Youngstown, OH metro area',
};

const listing = hasHero ? {
	'@context': 'https://schema.org',
	'@type': 'Place',
	name: rawTitle,
	description,
	photo: absImage,
	url: canonicalURL.toString(),
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Campbell',
		addressRegion: 'OH',
		addressCountry: 'US',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: 41.066722,
		longitude: -80.601631,
	},
} : null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index, follow" />

<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absImage} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={absImage} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(localBusiness)} is:inline />
{listing && <script type="application/ld+json" set:html={JSON.stringify(listing)} is:inline />}

<!-- Bootstrap 5 JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous" is:inline></script>

<ClientRouter />
